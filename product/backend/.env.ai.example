# 本地 Ollama + Qwen。请复制为 .env.ai；该文件不需要真实云端密钥。
# 启动前执行：ollama serve
# 首次使用执行：ollama pull qwen2.5:7b
LLM_API_KEY=ollama-local
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=180

# 政策 PDF 文本提取：auto 先用 pypdf，文本不足时自动回退 PaddleOCR。
# 可选值：auto、pypdf、paddleocr
POLICY_PDF_EXTRACTOR=auto
POLICY_PDF_MIN_TEXT_CHARS=80
PADDLEOCR_LANG=ch
PADDLEOCR_DPI=200

# 训练完成并导出的高级负荷模型文件路径。
LOAD_MODEL_PATH=

# Native-frequency load/price checkpoints from unified experiments.
# Server-owned trusted artifacts only; never accept pickle files from users.
FORECAST_ARTIFACT_ROOT=data/forecast_experiments
