# Deny by default: only production source and explicit build inputs enter context.
**
!backend/
!backend/requirements-runtime.txt
!backend/requirements-docker-forecast.txt
!backend/app/
!backend/app/**/
!backend/app/**/*.py
!backend/agents/
!backend/agents/*.py
!backend/scripts/
!backend/scripts/*.py
!backend/pv_inference/
!backend/pv_inference/*.py
!backend/pv_inference/manifest.json
!configs/
!configs/*.yaml
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.ts
!frontend/tsconfig*.json
!frontend/src/
!frontend/src/**
!frontend/nginx.conf
!THIRD_PARTY_NOTICES.md

# Defense in depth after the allowlist: no credentials, data, weights or caches.
**/.env*
**/*secret*
**/*credential*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/node_modules/**
**/__pycache__/**
**/*.pyc
**/data/**
**/models/**
**/*.csv
**/*.parquet
**/*.npz
**/*.npy
**/*.pt
**/*.pth
**/*.ckpt
**/*.onnx
**/*.safetensors
**/*.pkl
**/*.pickle
**/*.joblib
**/*.db*
**/*.sqlite*
**/*.bin
**/*.zip
**/*.tar
**/*.tar.gz
